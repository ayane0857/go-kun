{
  "name": "go-kun",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "vite build",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "post-cta-init": "pnpm dlx create-db@latest --user-agent tanstack/tsrouter",
    "db:generate": "dotenv run -f .env -- prisma generate",
    "db:push": "dotenv run -f .env -- prisma db push",
    "db:migrate": "dotenv run -f .env -- prisma migrate dev",
    "db:studio": "dotenv run -f .env -- prisma studio",
    "db:seed": "dotenv run -f .env -- prisma db seed"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-query": "5.106.1",
    "@tanstack/react-query-devtools": "5.106.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "dotenv": "^18.0.9",
    "nitro": "3.0.260610-beta",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "tailwindcss": "^4.3.4",
    "vite-plugin-neon-new": "^0.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tanstack/devtools-vite": "0.8.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "dotenv-cli": "^11.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "@prisma/engines",
      "prisma"
    ]
  }
}