generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Word {
  id        Int      @id @default(autoincrement())
  word      String   @unique
  meanings  String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([word])
}